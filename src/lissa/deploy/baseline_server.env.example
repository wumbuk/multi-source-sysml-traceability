# Copy to baseline_server.env. Set the absolute path of THIS project on Linux.
BASELINE_PROJECT_DIR=/path/to/multi-source-sysml-traceability/src/lissa
BASELINE_CONDA_ENV=lissa_env

# Both maintained Slurm workflows start their own Qwen service.
VLLM_CONDA_ENV=vllm_env
VLLM_MODEL_PATH=/home/zhangliushun/data/Qwen/Qwen3.5-27B
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen3.5-27B
LLM_API_KEY=EMPTY
LLM_TIMEOUT_SECONDS=86400
LLM_MAX_CONCURRENCY=1
LLM_ENABLE_THINKING=true
# Do not set LLM_MAX_TOKENS.
LLM_READY_INTERVAL_SECONDS=5

# Used by the full pipeline only. Oracle skips embedding and retrieval.
EMBEDDING_MODEL_PATH=${BASELINE_PROJECT_DIR}/embedding_model/all_Min
EMBEDDING_BASE_URL=http://127.0.0.1:9201/v1
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=EMPTY
EMBEDDING_READY_TIMEOUT_SECONDS=300
EMBEDDING_READY_INTERVAL_SECONDS=2
EMBEDDING_CPU_THREADS=8
