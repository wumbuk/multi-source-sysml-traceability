@prefix : <http://www.semanticweb.org/zls/ontologies/2026/0/KG/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/zls/ontologies/2026/0/KG/> .

<http://www.semanticweb.org/zls/ontologies/2026/0/KG> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/allocateTo
:allocateTo rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :relatesTo ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Block
                                        :Functional_Requirement
                                      )
                        ] ;
            rdfs:range :Action .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/refineTo
:refineTo rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :relatesTo ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Functional_Requirement
                                      :Interaction_Requirement
                                      :Interface_Requirement
                                      :Physical_Requirement
                                    )
                      ] ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :Action
                                     :Control_port
                                     :Information_port
                                     :Part_property
                                     :Physical_port
                                     :Value_property
                                   )
                     ] .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/relatesTo
:relatesTo rdf:type owl:ObjectProperty ;
           rdfs:domain :Requirement_Node ;
           rdfs:range :Element_Node .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/satisfyTo
:satisfyTo rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :relatesTo ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Functional_Requirement
                                       :Interaction_Requirement
                                       :Interface_Requirement
                                       :Physical_Requirement
                                     )
                       ] ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :Action
                                      :Block
                                      :Constraint_property
                                      :Information_port
                                      :Part_property
                                      :Physical_port
                                      :Value_property
                                    )
                      ] .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Description
:Description rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Node ;
             rdfs:comment "对于节点作用的描述" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/ID
:ID rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf owl:topDataProperty ;
    rdfs:domain :Node ;
    rdfs:comment "节点的ID" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/NType
:NType rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain :Node .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Name
:Name rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:domain :Node ;
      rdfs:comment "节点的名称" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Path
:Path rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:domain :Node ;
      rdfs:comment "存储节点在SysML中的建模路径" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Property
:Property rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :Node .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/ANode
:ANode rdf:type owl:Class ;
       rdfs:subClassOf :Action ;
       rdfs:comment "Activity Node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Action
:Action rdf:type owl:Class ;
        rdfs:subClassOf :Element_Node .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/BNode
:BNode rdf:type owl:Class ;
       rdfs:subClassOf :Block ;
       rdfs:comment "块节点" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Block
:Block rdf:type owl:Class ;
       rdfs:subClassOf :Element_Node .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Constraint_Requirement
:Constraint_Requirement rdf:type owl:Class ;
                        rdfs:subClassOf :Requirement_Node ;
                        rdfs:comment "Constraint Requirement Node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Constraint_property
:Constraint_property rdf:type owl:Class ;
                     rdfs:subClassOf :Property .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Control_port
:Control_port rdf:type owl:Class ;
              rdfs:subClassOf :Port ;
              rdfs:comment "Control Port Node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Element_Node
:Element_Node rdf:type owl:Class ;
              rdfs:subClassOf :Node ;
              owl:disjointWith :Functional_Requirement .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Functional_Requirement
:Functional_Requirement rdf:type owl:Class ;
                        rdfs:subClassOf :Requirement_Node ;
                        rdfs:comment "Functional Requirement Node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Information_port
:Information_port rdf:type owl:Class ;
                  rdfs:subClassOf :Port ;
                  rdfs:comment "Information port Node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Interaction_Requirement
:Interaction_Requirement rdf:type owl:Class ;
                         rdfs:subClassOf :Requirement_Node ;
                         rdfs:comment "Interaction Requirement Node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Interface_Requirement
:Interface_Requirement rdf:type owl:Class ;
                       rdfs:subClassOf :Requirement_Node .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Node
:Node rdf:type owl:Class ;
      rdfs:subClassOf owl:Thing .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/PNode
:PNode rdf:type owl:Class ;
       rdfs:subClassOf :Parameter ;
       rdfs:comment "Parameter Node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Parameter
:Parameter rdf:type owl:Class ;
           rdfs:subClassOf :Element_Node .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Part_property
:Part_property rdf:type owl:Class ;
               rdfs:subClassOf :Property ;
               rdfs:comment "Part Property Node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Physical_Requirement
:Physical_Requirement rdf:type owl:Class ;
                      rdfs:subClassOf :Requirement_Node ;
                      rdfs:comment "Physical Requirement Node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Physical_port
:Physical_port rdf:type owl:Class ;
               rdfs:subClassOf :Port ;
               rdfs:comment "physical port node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Port
:Port rdf:type owl:Class ;
      rdfs:subClassOf :Element_Node .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Property
:Property rdf:type owl:Class ;
          rdfs:subClassOf :Element_Node .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Requirement_Node
:Requirement_Node rdf:type owl:Class ;
                  rdfs:subClassOf :Node .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/SNode
:SNode rdf:type owl:Class ;
       rdfs:subClassOf :State ;
       rdfs:comment "State Node" .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/State
:State rdf:type owl:Class ;
       rdfs:subClassOf :Element_Node .


###  http://www.semanticweb.org/zls/ontologies/2026/0/KG/Value_property
:Value_property rdf:type owl:Class ;
                rdfs:subClassOf :Property ;
                rdfs:comment "Value Property Node" .


#################################################################
#    Annotations
#################################################################

:Property rdfs:comment "Node Property 用于表示节点的单位或者端口的名称等" .


#################################################################
#    Rules
#################################################################

:a rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:b rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "S5" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Functional_Requirement ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :a
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :relatesTo ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :a ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :b
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :Part_property ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :b
                                                                           ] ;
                                                                 rdf:rest rdf:nil
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :refineTo ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :a ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :b
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

