# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Local credentials; keep configuration templates
.env
.env.*
.env-*
*.env
!.env.example
!.env.*.example
!*.env.example

# IDE and operating-system files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
~$*

# Dependency caches and compiled output
node_modules/
.gradle/
.cache/
**/target/
**/build/
*.class

# Downloaded / trained model weights and training checkpoints
*.safetensors
*.pt
*.pth
pytorch_model*.bin
checkpoints/
checkpoint-*/

# Keep Maven / Gradle wrapper JARs and vendored runtime libraries.

