# Copy this file to .env for local development. Never commit the real .env.

# ---------------------------------------------------------------------------
# Dataset and output paths
# ---------------------------------------------------------------------------
# Relative paths are accepted; absolute Windows/Linux paths are also supported.
TRACE_DATASET_DIR=Data/GenerateContext/Air_Condition
TRACE_SEMANTIC_DATASET_PATH=Data/GenerateContext/Air_Condition/Air_Condition.csv
TRACE_KG_CSV_PATH=Data/GenerateContext/Air_Condition/KG.csv
TRACE_JUDGE_CSV_PATH=Data/GenerateContext/Air_Condition/Judge.csv
TRACE_PORT_INFORMATION_PATH=Data/Port_Information/关于端口信息流动的XMI.txt
TRACE_OUTPUT_RESULT_PATH=result/runs/latest/predictions.json
TRACE_SFT_SAMPLE_PATH=result/sft_samples/llm_samples.jsonl

# ---------------------------------------------------------------------------
# Embedding model
# ---------------------------------------------------------------------------
# Use a Hugging Face model ID or a local model directory.
TRACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Examples: cuda, cuda:0, cpu. Leave empty for automatic selection.
TRACE_EMBEDDING_DEVICE=

# ---------------------------------------------------------------------------
# Main OpenAI-compatible LLM service (for example, vLLM)
# ---------------------------------------------------------------------------
TRACE_LLM_BASE_URL=http://localhost:8080/v1
TRACE_LLM_MODEL=Qwen/Qwen3.5-27B
# Local vLLM usually accepts EMPTY. Use a real key only for remote services.
TRACE_LLM_API_KEY=EMPTY

# Optional per-mode overrides. Leave empty to inherit TRACE_LLM_*.
TRACE_SINGLE_STAGE_BASE_URL=
TRACE_SINGLE_STAGE_MODEL=
TRACE_SINGLE_STAGE_API_KEY=
TRACE_TWO_STAGE_BASE_URL=
TRACE_TWO_STAGE_MODEL=
TRACE_TWO_STAGE_API_KEY=
TRACE_TWO_STAGE_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Semantic enrichment service
# ---------------------------------------------------------------------------
# This key is intentionally blank. Supply it only in your private .env.
TRACE_ENRICHMENT_API_KEY=
TRACE_ENRICHMENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TRACE_ENRICHMENT_MODEL=deepseek-v4-pro

# ---------------------------------------------------------------------------
# Java ontology reasoner
# ---------------------------------------------------------------------------
TRACE_REASONER_JAR_PATH=protege_reasoner/kg-reasoner/build/libs/kg-reasoner-1.0-SNAPSHOT.jar
TRACE_REASONER_WORK_DIR=protege_reasoner/kg-reasoner
TRACE_ONTOLOGY_PATH=protege_reasoner/kg-reasoner/ontology/KG.ttl
